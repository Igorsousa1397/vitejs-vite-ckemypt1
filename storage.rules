rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos do termo (documento + selfie) são enviadas sem login pelo próprio
    // encontrista; só a liderança logada consegue abrir.
    // Sem checar contentType: o iOS às vezes entrega o arquivo sem tipo e o SDK
    // manda "application/octet-stream" — barrar por tipo derrubava o envio.
    // O app define o tipo pela extensão, e o limite de tamanho segura o resto.
    match /termos/{encId}/{arquivo} {
      allow write: if request.resource.size < 8 * 1024 * 1024;
      allow read: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
